#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: t-new [-c directory] [session-name]" >&2
  exit 1
}

dir=""
session=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -c)
      [[ $# -ge 2 ]] || usage
      dir="$2"
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    -*)
      usage
      ;;
    *)
      [[ -z "$session" ]] || usage
      session="$1"
      shift
      ;;
  esac
done

if [[ -z "$dir" ]]; then
  dir="$PWD"
elif [[ ! -d "$dir" ]]; then
  echo "t-new: not a directory: $dir" >&2
  exit 1
fi

# Always pass -c so we never expand an empty array (bash 3.2 + set -u
# treats "${arr[@]}" as unbound). =name: is an exact session target so
# numeric names like 0 are not treated as window indexes.
if [[ -n "$session" ]]; then
  tmux new-session -d -s "$session" -c "$dir"
else
  session="$(tmux new-session -d -c "$dir" -P -F '#S')"
fi

tmux new-window -t "=${session}:" -c "$dir"
tmux new-window -t "=${session}:" -c "$dir"
tmux rename-window -t "=${session}:1" agent

if [[ -n "${TMUX:-}" ]]; then
  tmux switch-client -t "=${session}"
else
  exec tmux attach -t "=${session}"
fi
