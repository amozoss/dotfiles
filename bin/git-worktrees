#!/usr/bin/env bash
# List or add git worktrees. Not tied to any AI CLI.
set -euo pipefail

usage() {
  echo "usage: git-worktrees list <repo>" >&2
  echo "       git-worktrees add <repo> <name> [start-point]" >&2
  exit 1
}

[[ $# -ge 2 ]] || usage
cmd="$1"
repo="$2"
shift 2

command -v git >/dev/null 2>&1 || { echo "git-worktrees: git not found" >&2; exit 1; }
[[ -d "$repo" ]] || { echo "git-worktrees: not a directory: $repo" >&2; exit 1; }
git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
  echo "git-worktrees: not a git work tree: $repo" >&2
  exit 1
}

list_worktrees() {
  local path="" branch=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" ]]; then
      if [[ -n "$path" ]]; then
        printf '%s\t%s\t%s\n' "$path" "${branch:-}" "$(basename "$path")"
      fi
      path=""
      branch=""
      continue
    fi
    case "$line" in
      worktree\ *) path="${line#worktree }" ;;
      branch\ *)
        branch="${line#branch }"
        branch="${branch#refs/heads/}"
        ;;
      detached) branch="detached" ;;
      bare) branch="bare" ;;
    esac
  done < <(git -C "$repo" worktree list --porcelain)
  if [[ -n "$path" ]]; then
    printf '%s\t%s\t%s\n' "$path" "${branch:-}" "$(basename "$path")"
  fi
}

add_worktree() {
  [[ $# -ge 1 ]] || usage
  local name="$1"
  local start="${2:-}"
  local root parent base dest
  root="$(git -C "$repo" rev-parse --show-toplevel)"
  parent="$(dirname "$root")"
  base="$(basename "$root")"
  dest="${parent}/${base}-${name}"

  if [[ -e "$dest" ]]; then
    echo "git-worktrees: already exists: $dest" >&2
    exit 1
  fi

  if git -C "$root" show-ref --verify --quiet "refs/heads/${name}"; then
    git -C "$root" worktree add "$dest" "$name"
  elif [[ -n "$start" ]]; then
    git -C "$root" worktree add -b "$name" "$dest" "$start"
  else
    git -C "$root" worktree add -b "$name" "$dest"
  fi
  printf '%s\n' "$dest"
}

case "$cmd" in
  list)
    [[ $# -eq 0 ]] || usage
    list_worktrees
    ;;
  add)
    add_worktree "$@"
    ;;
  *)
    usage
    ;;
esac
